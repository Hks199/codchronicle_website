VITE_APP_NAME=CodeChronicle
VITE_SITE_URL=https://example.com
VITE_WHATSAPP_NUMBER=919518545028
VITE_INSTAGRAM_URL=https://www.instagram.com/codechronicle.in/
VITE_FACEBOOK_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=

# Server-only email settings. Never add VITE_ to SMTP credentials.
# Code settings in server/mail-settings.mjs take priority by default.
# Set SMTP_CONFIG_SOURCE=environment to use only these environment variables.
SMTP_CONFIG_SOURCE=code
# Obtain these from your email provider. Keep .env private.
SMTP_HOST=
SMTP_PORT=587
# false for STARTTLS on port 587; true for TLS on port 465
SMTP_SECURE=false
# For Gmail, use the full Gmail/Google Workspace email address, not a name.
SMTP_USER=
# SMTP password or provider-issued app password. Quote values containing #.
# Gmail: use a Google App Password with its grouping spaces removed.
SMTP_PASS=
# Verified sender email address (usually the same as SMTP_USER)
MAIL_FROM=
# Your inbox: receives both contact inquiries and career applications
MAIL_TO=
# Optional separate recipients; leave blank to use MAIL_TO
CONTACT_MAIL_TO=
CAREERS_MAIL_TO=

# API server: Vite proxies /api to port 3001 during development
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
# Comma-separated website origins, e.g. https://codechronicle.in
# If blank, VITE_SITE_URL is used; localhost is also allowed in development.
ALLOWED_ORIGINS=
# Set production on deployment; use SERVER_HOST=0.0.0.0 if your host requires it.
NODE_ENV=development
# Only set to your known reverse-proxy hop count when deployed behind a proxy.
TRUST_PROXY=
